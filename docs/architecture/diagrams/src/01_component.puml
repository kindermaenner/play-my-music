@startuml
package "App Module" {
    [MainScreen] --> [MainViewModel]
    [MainViewModel] --> [SettingsRepository]
    [MainViewModel] --> [IdentifyTrackUseCase]
    [MainViewModel] --> [ResolveTrackUriUseCase]
    [MainScreen] --> [ExoPlayer]
}

package "Domain Module" {
    [IdentifyTrackUseCase]
    [ResolveTrackUriUseCase]
    interface MappingRepository
    interface LocalTrackResolver
}

package "Data Module" {
    [JsonMappingRepository]
    [AppLocalTrackResolver]
}

[IdentifyTrackUseCase] --> MappingRepository
[ResolveTrackUriUseCase] --> LocalTrackResolver

MappingRepository <|-- [JsonMappingRepository]
LocalTrackResolver <|-- [AppLocalTrackResolver]

[ExoPlayer] --> [SmbDataSource]
[SmbDataSource] --> [jcifs-ng]
@enduml