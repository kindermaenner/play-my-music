@startuml
package "Domain" {
    class Track {
        +int id
        +String title
        +String artist
        +String edition
        +String urlPart
    }

    class PlaybackConfig {
        +String nasAddress
        +String nasBaseFolder
    }

    interface MappingRepository {
        +getTrack(urlPart, id): Track
    }

    interface LocalTrackResolver {
        +resolveLocalUri(track): String
    }
}

package "Data" {
    class JsonMappingRepository
    class AppLocalTrackResolver
    class MappingFile
    class Song
}

MappingRepository <|-- JsonMappingRepository
LocalTrackResolver <|-- AppLocalTrackResolver

JsonMappingRepository ..> MappingFile
MappingFile *-- Song
@enduml