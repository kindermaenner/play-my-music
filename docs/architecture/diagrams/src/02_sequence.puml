@startuml
actor User
participant "Camera" as Cam
participant "MainScreen" as UI
participant "MainViewModel" as VM
participant "IdentifyTrackUseCase" as ID
participant "ResolveTrackUriUseCase" as RES
participant "ExoPlayer" as Player

User -> Cam : Scans QR
Cam -> UI : onValidResult(text)
UI -> VM : onQrScanned(text)
VM -> ID : invoke(text, prefix)
ID -> VM : Track
VM -> RES : invoke(track, config)
RES -> VM : playbackUri
VM -> UI : UiState updated
UI -> Player : setMediaItem(uri)
UI -> Player : play()
@enduml